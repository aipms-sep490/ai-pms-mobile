<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release builds enforce HTTPS-only traffic. Debug overrides this via src/debug/AndroidManifest.xml. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
